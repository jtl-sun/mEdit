{
  "name": "marktext",
  "productName": "mEdit",
  "version": "0.21.7",
  "description": "mEdit Markdown editor",
  "main": "./out/main/index.js",
  "author": {
    "name": "Jocs",
    "email": "ransixi@gmail.com",
    "url": "https://github.com/Jocs"
  },
  "maintainer": [
    {
      "name": "Jocs",
      "email": "ransixi@gmail.com",
      "url": "https://github.com/Jocs"
    },
    {
      "name": "Felix Häusler",
      "email": "hfelix@protonmail.ch",
      "url": "https://github.com/fxha"
    },
    {
      "name": "Tkaixiang",
      "email": "tkaixiang@gmail.com",
      "url": "https://github.com/tkaixiang"
    }
  ],
  "scripts": {
    "minify-locales": "tsx ../../scripts/minify-locales.ts",
    "rebuild-native": "electron-rebuild -f",
    "start": "cross-env PERF_TESTING=true electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "tsx ../../scripts/minify-locales.ts && electron-vite build",
    "build:win": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --x64 --publish never",
    "build:win:x64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --x64 --publish never",
    "build:win:arm64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --win --arm64 --publish never",
    "build:mac": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --publish never",
    "build:mac:x64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --x64 --publish never",
    "build:mac:arm64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --mac --arm64 --publish never",
    "build:linux": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux --publish never",
    "build:linux:x64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "build:linux:arm64": "tsx ../../scripts/minify-locales.ts && electron-rebuild && electron-vite build && electron-builder --linux AppImage deb --arm64 --publish never",
    "perf:inspect": "cross-env PERF_TESTING=true electron-vite preview -- --inspect=5858",
    "perf:inspect-brk": "cross-env PERF_TESTING=true electron-vite preview -- --inspect-brk=5858",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "playwright test test/e2e",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "vue-tsc --noEmit -p tsconfig.json --watch"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@intlify/core-base": "^11.4.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@hfelix/electron-localshortcut": "^4.0.1",
    "@marktext/file-icons": "^1.0.6",
    "@marktext/muyajs": "workspace:*",
    "@muyajs/core": "workspace:*",
    "@popperjs/core": "^2.11.8",
    "@vscode/ripgrep": "^1.18.0",
    "arg": "^5.0.2",
    "axios": "^1.18.0",
    "ced": "^2.0.0",
    "chokidar": "^5.0.0",
    "codemirror": "^5.65.21",
    "command-exists": "^1.2.9",
    "deep-equal": "^2.2.3",
    "dom-autoscroller": "^2.3.4",
    "dompurify": "^3.4.11",
    "dragula": "^3.7.3",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "element-plus": "^2.14.2",
    "element-resize-detector": "^1.2.4",
    "execall": "^3.0.0",
    "flowchart.js": "^1.18.0",
    "font-list": "^2.1.0",
    "fs-extra": "^11.3.5",
    "fuzzaldrin": "^1.0.0",
    "github-markdown-css": "^5.8.1",
    "html-tags": "^3.3.1",
    "iso-639-1": "^3.1.0",
    "joplin-turndown-plugin-gfm": "^1.0.76",
    "katex": "^0.16.22",
    "keytar": "^7.9.0",
    "lodash": "^4.17.21",
    "mermaid": "^11.12.1",
    "mitt": "^3.0.1",
    "ms": "^2.1.3",
    "pako": "^2.1.0",
    "pathe": "^2.0.3",
    "pinia": "^3.0.3",
    "plist": "^3.1.0",
    "prismjs": "^1.30.0",
    "snabbdom": "^3.6.3",
    "snabbdom-to-html": "^7.1.0",
    "snapsvg-cjs": "^0.0.6",
    "turndown": "^7.2.0",
    "underscore": "^1.13.7",
    "vega-embed": "^7.0.2",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28",
    "write-file-atomic": "^7.0.0"
  },
  "optionalDependencies": {
    "native-keymap": "^3.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@playwright/test": "^1.55.1",
    "@types/codemirror": "^5.60.16",
    "@types/deep-equal": "^1.0.4",
    "@types/dragula": "^3.7.4",
    "@types/element-resize-detector": "^1.1.6",
    "@types/fs-extra": "^11.0.4",
    "@types/fuzzaldrin": "^1.0.9",
    "@types/lodash": "^4.17.20",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.18.6",
    "@types/turndown": "^5.0.5",
    "@types/webfontloader": "^1.6.38",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.0.0",
    "electron": "~38.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.0.0",
    "patch-package": "^8.0.0",
    "postcss-preset-env": "^10.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.21",
    "vue-tsc": "^3.0.7"
  }
}
